#!/usr/bin/env bash
# superPod Git pre-push hook
# Runs regression test suite before allowing push to remote

set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT"

echo "================================================================"
echo " [Git Hook: pre-push] Running superPod regression tests..."
echo "================================================================"

if [ -f "./tests/run_tests.sh" ]; then
    ./tests/run_tests.sh
    TEST_EXIT=$?
    if [ $TEST_EXIT -ne 0 ]; then
        echo ""
        echo "❌ [Git Hook: pre-push] Regression tests failed!"
        echo "   Push aborted. Please fix test failures before pushing."
        echo "   (To bypass in an emergency, use: git push --no-verify)"
        exit 1
    fi
else
    echo "⚠️  [Git Hook: pre-push] Warning: tests/run_tests.sh not found. Skipping."
fi

echo "✔ [Git Hook: pre-push] All regression tests passed. Proceeding with push."
exit 0

